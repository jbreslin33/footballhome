[Unit]
Description=Football Home — Instagram token refresh timer (1st + 20th, 3:30am)
Documentation=file:///srv/footballhome/scripts/refresh-instagram-token.sh
Requires=refresh-instagram-token.service

[Timer]
# Crontab-equivalent of "30 3 1,20 * *" — no native systemd "every N
# days" either, so mirror the same ~20-day-cadence workaround the cron
# comment used, well inside the 60-day token lifetime / 10-day margin.
OnCalendar=*-*-01 03:30:00
OnCalendar=*-*-20 03:30:00
Persistent=true
RandomizedDelaySec=60s
Unit=refresh-instagram-token.service

[Install]
WantedBy=timers.target
