<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- FH Assistant (was FH Texter): sends the one text a coach clicked Send
         on in Football Home, from this phone's number — nothing is ever sent
         on its own — and keeps the club's contacts in the phone's Google
         account.  Same package, so it installs over FH Texter. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- v1.3: Samsung's SMS stack reads the SIM's group id (TelephonyManager
         .getGroupIdLevel1) inside sendMultipartTextMessage and throws a
         SecurityException without this — every send failed from 11/6. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v1.4 FH Assistant: the club's contacts into the picked Google account. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- v1.5: one-tap updates (downloads its own APK, Android asks Install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_texter"
        android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".RelayService"
                 android:exported="false"
                 android:foregroundServiceType="dataSync" />
        <receiver android:name=".SmsResultReceiver" android:exported="false" />
        <receiver android:name=".Updater$Result" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
